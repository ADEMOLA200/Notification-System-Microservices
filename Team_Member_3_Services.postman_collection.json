		{
			"name": "RabbitMQ Management",
			"item": [
				{
					"name": "Publish Email Notification",
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "{{rabbitmq_user}}",
									"type": "string"
								},
								{
									"key": "password",
									"value": "{{rabbitmq_password}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"properties\": {},\n    \"routing_key\": \"email\",\n    \"payload\": \"{\\\"user_id\\\":\\\"{{user_id}}\\\",\\\"template_code\\\":\\\"WELCOME_EMAIL\\\",\\\"variables\\\":{\\\"subject\\\":\\\"Welcome to Our Platform!\\\",\\\"name\\\":\\\"John Doe\\\",\\\"company\\\":\\\"Acme Corp\\\",\\\"verification_link\\\":\\\"https://example.com/verify?token=abc123\\\"},\\\"request_id\\\":\\\"req-{{$guid}}\\\",\\\"notification_id\\\":\\\"{{$guid}}\\\"}\",\n    \"payload_encoding\": \"string\"\n}"
						},
						"url": {
							"raw": "{{rabbitmq_management_url}}/api/exchanges/%2F/notifications.direct/publish",
							"host": [
								"{{rabbitmq_management_url}}"
							],
							"path": [
								"api",
								"exchanges",
								"%2F",
								"notifications.direct",
								"publish"
							]
						},
						"description": "Publish an email notification message to RabbitMQ. This will be consumed by the Email Service.\n\n**IMPORTANT: You must create the notification record in the database FIRST!**\n\nUse the helper script instead:\n```bash\n./send-test-email.sh\n```\n\nOr manually create notification:\n```sql\nINSERT INTO notifications (id, user_id, notification_type, template_code, status, variables, request_id, created_at, updated_at)\nVALUES ('YOUR-UUID-HERE', '{{user_id}}', 'email', 'WELCOME_EMAIL', 'pending', '{\"subject\":\"Welcome!\",\"name\":\"John Doe\"}', 'YOUR-REQUEST-UUID', NOW(), NOW());\n```\n\n**Prerequisites:**\n1. User must exist in database with valid email\n2. Template must exist (WELCOME_EMAIL)\n3. Notification record created with matching notification_id\n4. Email service must be running\n5. SendGrid API key configured or SMTP configured\n\n**Message Fields:**\n- `user_id`: User UUID from database\n- `template_code`: Template to render\n- `variables`: Data for template (must include 'subject')\n- `request_id`: Correlation ID for tracking\n- `notification_id`: Notification UUID from database"
					},
					"response": []
				},
				{
					"name": "Publish Push Notification",
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "{{rabbitmq_user}}",
									"type": "string"
								},
								{
									"key": "password",
									"value": "{{rabbitmq_password}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"properties\": {},\n    \"routing_key\": \"push\",\n    \"payload\": \"{\\\"user_id\\\":\\\"{{user_id}}\\\",\\\"template_code\\\":\\\"WELCOME_EMAIL\\\",\\\"variables\\\":{\\\"title\\\":\\\"Welcome!\\\",\\\"body\\\":\\\"Welcome to our platform\\\",\\\"name\\\":\\\"John Doe\\\",\\\"company\\\":\\\"Acme Corp\\\",\\\"verification_link\\\":\\\"https://example.com\\\"},\\\"request_id\\\":\\\"{{$guid}}\\\",\\\"notification_id\\\":\\\"{{$guid}}\\\"}\",\n    \"payload_encoding\": \"string\"\n}"
						},
						"url": {
							"raw": "{{rabbitmq_management_url}}/api/exchanges/%2F/notifications.direct/publish",
							"host": [
								"{{rabbitmq_management_url}}"
							],
							"path": [
								"api",
								"exchanges",
								"%2F",
								"notifications.direct",
								"publish"
							]
						},
						"description": "Publish a push notification message to RabbitMQ. This will be consumed by the Push Service.\n\n**IMPORTANT: You must create the notification record in the database FIRST!**\n\nUse the helper script instead:\n```bash\n./send-test-push.sh\n```\n\nOr manually create notification:\n```sql\nINSERT INTO notifications (id, user_id, notification_type, template_code, status, variables, request_id, created_at, updated_at)\nVALUES ('YOUR-UUID-HERE', '{{user_id}}', 'push', 'WELCOME_EMAIL', 'pending', '{\"title\":\"Welcome!\",\"body\":\"Welcome to our platform\"}', 'YOUR-REQUEST-UUID', NOW(), NOW());\n```\n\n**Prerequisites:**\n1. User must exist in database with valid push_token\n2. Template must exist (WELCOME_EMAIL)\n3. Notification record created with matching notification_id\n4. Push service must be running\n5. FCM server key must be configured\n\n**Variables:**\n- `title`: Notification title\n- `body`: Notification body\n- `name`, `company`, `verification_link`: Template variables"
					},
					"response": []
				},
