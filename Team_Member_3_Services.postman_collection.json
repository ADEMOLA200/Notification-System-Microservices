	"item": [
		{
			"name": "Email Service (3002)",
			"item": [
				{
					"name": "Health Check",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Service is healthy\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data.status).to.eql('healthy');",
									"});",
									"",
									"pm.test(\"Database connected\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.database).to.eql('connected');",
									"});",
									"",
									"pm.test(\"Circuit breakers present\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('circuitBreakers');",
									"    pm.expect(jsonData.data.circuitBreakers).to.have.property('templateService');",
									"    pm.expect(jsonData.data.circuitBreakers).to.have.property('emailProvider');",
									"    pm.expect(jsonData.data.circuitBreakers).to.have.property('rateLimiter');",
									"});",
									"",
									"pm.test(\"Circuit breakers are CLOSED (healthy)\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.circuitBreakers.templateService.state).to.be.oneOf(['CLOSED', 'HALF_OPEN']);",
									"    pm.expect(jsonData.data.circuitBreakers.emailProvider.state).to.be.oneOf(['CLOSED', 'HALF_OPEN']);",
									"});",
									"",
									"console.log('Email Service Health:', JSON.stringify(pm.response.json().data, null, 2));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{email_service_url}}/health",
							"host": [
								"{{email_service_url}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Check Email Service health status including database connectivity and circuit breaker states."
					},
					"response": []
				},
				{
					"name": "Service Info",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 404 (expected for root)\", function () {",
									"    pm.response.to.have.status(404);",
									"});",
									"",
									"pm.test(\"Service responds with standard error format\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('success');",
									"    pm.expect(jsonData).to.have.property('error');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{email_service_url}}/",
							"host": [
								"{{email_service_url}}"
							],
							"path": [
								""
							]
						},
						"description": "Root endpoint (expect 404 as email service is consumer-only)."
					},
					"response": []
				}
			],
			"description": "Email Service endpoints for health monitoring and status checks."
