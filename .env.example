# Database Configuration (Supabase PostgreSQL)
DB_HOST=your-supabase-host.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=your-database-user
DB_PASSWORD=your-secure-database-password
DB_SSL=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRY=7d
BCRYPT_ROUNDS=10

# RabbitMQ Configuration
RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672

# Redis Configuration
REDIS_URL=redis://redis:6379

# Service URLs (for API Gateway)
USER_SERVICE_URL=http://user-service:3001
TEMPLATE_SERVICE_URL=http://template-service:3004
EMAIL_SERVICE_URL=http://email-service:3002
PUSH_SERVICE_URL=http://push-service:3003

# Email Provider Configuration (for Email Service - Team Member 3)
# Choose provider: 'sendgrid' or 'smtp' (defaults to sendgrid if both configured)
EMAIL_PROVIDER=sendgrid

# SendGrid Configuration (Recommended for production)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@your-domain.com
SENDGRID_FROM_NAME=Notification System

# SMTP Configuration (Fallback or alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@your-domain.com

# Firebase Cloud Messaging (for Push Service - Team Member 3)
FCM_SERVER_KEY=your-firebase-server-key

# Application Settings
NODE_ENV=development
