const axios = require('axios');
const { dbPool } = require('../database/connection');
const logger = require('../utils/logger');
const RetryHandler = require('../utils/retryHandler');
const CircuitBreaker = require('../utils/circuitBreaker');
const RateLimiter = require('../utils/rateLimiter');
const SendGridProvider = require('./sendgridProvider');
const SMTPProvider = require('./smtpProvider');

const retryHandler = new RetryHandler(5, 1000, 32000);
const templateServiceBreaker = new CircuitBreaker({
  name: 'TemplateService',
  failureThreshold: 5,
  resetTimeout: 60000
});
const emailProviderBreaker = new CircuitBreaker({
  name: 'EmailProvider',
  failureThreshold: 3,
  resetTimeout: 30000
});
const emailRateLimiter = new RateLimiter({
  name: 'EmailProvider',
  maxRequests: 100,
  windowMs: 60000
});

const sendgridProvider = new SendGridProvider();
const smtpProvider = new SMTPProvider();

async function processEmailNotification(message) {
  const client = await dbPool.connect();
  const startTime = Date.now();
  
  try {
    const { user_id, template_code, variables, request_id, notification_id, retry_count = 0 } = message;

    logger.info('Processing email notification', {
      notificationId: notification_id,
      userId: user_id,
      templateCode: template_code,
      requestId: request_id,
      retryCount: retry_count
    });

    await client.query(
      `UPDATE notifications 
       SET status = 'processing', 
           metadata = jsonb_set(COALESCE(metadata, '{}'::jsonb), '{retry_count}', $1::text::jsonb),
           updated_at = NOW()
       WHERE id = $2`,
      [retry_count, notification_id]
    );

    const userResult = await client.query(
      'SELECT email, first_name, last_name FROM users WHERE id = $1',
      [user_id]
    );

    if (userResult.rows.length === 0) {
      throw new Error('User not found');
    }

    const { email, first_name, last_name } = userResult.rows[0];

    if (!email) {
      throw new Error('User has no email address');
    }

    const renderedContent = await fetchTemplateWithRetry(template_code, variables, request_id);

    await emailRateLimiter.acquire();

    const emailResult = await sendEmailWithFallback({
      to: email,
      subject: variables.subject || 'Notification',
      html: renderedContent,
      text: variables.text,
      replyTo: variables.reply_to
    }, request_id);

    const processingTime = Date.now() - startTime;

    await client.query(
      `UPDATE notifications 
       SET status = 'sent', 
           sent_at = NOW(),
           metadata = jsonb_set(
             jsonb_set(
               jsonb_set(
                 COALESCE(metadata, '{}'::jsonb), 
                 '{provider}', 
                 to_jsonb($1::text)
               ),
               '{message_id}',
               to_jsonb($2::text)
             ),
             '{processing_time_ms}',
             to_jsonb($3::int)
           ),
           updated_at = NOW()
       WHERE id = $4`,
      [emailResult.provider, emailResult.messageId, processingTime, notification_id]
    );

    logger.info('Email sent successfully', { 
      notificationId: notification_id, 
      userId: user_id,
      email,
      provider: emailResult.provider,
      messageId: emailResult.messageId,
      processingTimeMs: processingTime,
      requestId: request_id,
      retryCount: retry_count
    });

    return { success: true, provider: emailResult.provider };

  } catch (error) {
    const processingTime = Date.now() - startTime;
    
    logger.error('Failed to send email', { 
      error: error.message,
      stack: error.stack,
      message,
      processingTimeMs: processingTime
    });
    
    await client.query(
      `UPDATE notifications 
       SET status = 'failed', 
           metadata = jsonb_set(
             jsonb_set(
               COALESCE(metadata, '{}'::jsonb), 
               '{error}', 
               to_jsonb($1::text)
             ),
             '{failed_at}',
             to_jsonb($2::text)
           ),
           updated_at = NOW()
       WHERE id = $3`,
      [error.message, new Date().toISOString(), message.notification_id]
    );

    throw error;
  } finally {
    client.release();
  }
}

async function fetchTemplateWithRetry(templateCode, variables, requestId) {
  const result = await retryHandler.executeWithRetry(
    async () => {
      return await templateServiceBreaker.execute(async () => {
        const response = await axios.post(
          `${process.env.TEMPLATE_SERVICE_URL}/api/v1/templates/${templateCode}/render`,
          { variables },
          { 
            timeout: 10000,
            headers: {
              'X-Request-ID': requestId
            }
          }
        );
        return response.data.data.rendered_content;
      });
    },
    { templateCode, requestId }
  );

  if (!result.success) {
    throw result.error;
  }

  return result.result;
}

async function sendEmailWithFallback(emailData, requestId) {
  const preferSendGrid = process.env.EMAIL_PROVIDER === 'sendgrid' || sendgridProvider.isConfigured();
  
  const providers = preferSendGrid 
    ? [sendgridProvider, smtpProvider]
    : [smtpProvider, sendgridProvider];

  let lastError;

  for (const provider of providers) {
    if (!provider.isConfigured()) {
      logger.warn('Provider not configured, skipping', {
        provider: provider.constructor.name
      });
      continue;
    }

    try {
      const result = await retryHandler.executeWithRetry(
        async () => {
          return await emailProviderBreaker.execute(async () => {
            return await provider.sendEmail(emailData);
          });
        },
        { provider: provider.constructor.name, to: emailData.to, requestId }
      );

      if (result.success) {
        return result.result;
      } else {
        lastError = result.error;
      }
    } catch (error) {
      logger.warn('Provider failed, trying fallback', {
        provider: provider.constructor.name,
        error: error.message
      });
      lastError = error;
    }
  }

  throw lastError || new Error('All email providers failed');
}

function getCircuitBreakerStats() {
  return {
    templateService: templateServiceBreaker.getState(),
    emailProvider: emailProviderBreaker.getState(),
    rateLimiter: emailRateLimiter.getStats()
  };
}

module.exports = { 
  processEmailNotification,
  getCircuitBreakerStats
};
